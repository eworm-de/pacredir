[Unit]
Description=Announce pacman database files and package archives
Documentation=https://pacredir.eworm.de/
After=pacserve.service systemd-resolved.service
Requires=systemd-resolved.service
BindsTo=pacserve.service
Requires=systemd-resolved.service

[Service]
Type=notify
ExecStart=/usr/lib/pacredir/pacserve-announce
ProtectSystem=full
ProtectHome=on
PrivateDevices=on
NoNewPrivileges=on
