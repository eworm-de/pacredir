PORT="$(grep -E '^PORT=' /etc/pacserve.conf | cut -d= -f2 | tr -d '[:space:]')"

exec avahi-publish -s "pacserve on %l" "_pacserve._tcp" "${PORT}" "id=%ID%" "arch=%ARCH%"
